val xv_param_tail : (Mgoast.ident * Mgoast.typ) list
val xv_param_list : (Mgoast.ident * Mgoast.typ) list
val xv_mgotype : Mgoast.typ
val xv_list_decl_ : Mgoast.decl list
val xv_instr_simple_opt : Mgoast.instr option
val xv_instr_simple : Mgoast.instr
val xv_instr_if : Mgoast.instr
val xv_instr : Mgoast.instr
val xv_idents1 : Mgoast.ident list
val xv_ident : Mgoast.ident
