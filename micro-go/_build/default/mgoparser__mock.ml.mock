  open Lexing
  open Mgoast

  exception Error

  (* fonctions utilitaires pour construire des nœuds de l'AST avec leur position *)
  let mk_i loc idesc = { idesc; iloc = loc }
  let mk_var id = { edesc = Var id; eloc = id.loc }
  let mk_bool loc b = { edesc = Bool b; eloc = loc }
  let only_vars el =
    List.map (fun e ->
        match e.edesc with
        | Var id -> id
        | _ -> raise Error) el


